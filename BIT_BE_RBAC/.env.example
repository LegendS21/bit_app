# ------------------------------------------------------------------
# Contoh konfigurasi service RBAC. Salin jadi .env lalu sesuaikan.
# File ini boleh di-commit — JANGAN taruh nilai rahasia asli di sini.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3001
TRUST_PROXY=1

# --- CORS: hanya domain frontend, pisahkan dengan koma ---
CORS_ORIGIN=http://localhost:5173

# --- JWT access token (RS256) ---
JWT_ISSUER=bit-be-rbac
JWT_AUDIENCE=bit-beasiswa
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
ACCESS_TOKEN_TTL_DETIK=900

# --- Refresh token ---
REFRESH_TOKEN_TTL_HARI=7
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/
REFRESH_GRACE_DETIK=10
COOKIE_SECURE=false

# --- Rate limit ---
RATE_LIMIT_PER_MENIT=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REFRESH=30

# --- Pengunci akun saat login gagal beruntun ---
MAX_GAGAL_LOGIN=5
LAMA_KUNCI_MENIT=15

# --- Seeder ---
# Nilai yang mengandung '#' WAJIB diapit tanda kutip — tanpa kutip, dotenv
# menganggap sisanya sebagai komentar.
SEED_ADMIN_EMAIL=admin@bit.test
SEED_ADMIN_PASSWORD="ganti-password-ini"
SEED_VERIFIKATOR_EMAIL=verifikator@bit.test
SEED_VERIFIKATOR_PASSWORD="ganti-password-ini"
SEED_SELEKSI_EMAIL=seleksi@bit.test
SEED_SELEKSI_PASSWORD="ganti-password-ini"
SEED_APPLICANT_EMAIL=peserta@bit.test
SEED_APPLICANT_PASSWORD="ganti-password-ini"
