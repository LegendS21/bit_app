const path = require('path');

// sequelize-cli defaultnya mencari config/config.json. Kredensial sekarang
// dibaca dari environment lewat config/config.js, jadi CLI perlu diarahkan
// ke sana — kalau tidak, `db:migrate` di dalam container akan tetap mencoba
// menyambung ke 127.0.0.1 dan gagal.
module.exports = {
  config: path.resolve('config', 'config.js'),
  'models-path': path.resolve('models'),
  'seeders-path': path.resolve('seeders'),
  'migrations-path': path.resolve('migrations'),
};
