# ------------------------------------------------------------------
# Contoh konfigurasi API Gateway. Salin jadi .env lalu sesuaikan.
# File ini boleh di-commit — JANGAN taruh nilai rahasia asli di sini.
#
# Gateway tidak punya database dan tidak menyimpan apa pun.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3000
TRUST_PROXY=1

# --- CORS ---
# Dalam susunan normal, FE dilayani lewat gateway ini juga sehingga
# origin-nya sama dan CORS tidak terpakai. Nilai ini dipakai saat FE
# dijalankan terpisah dengan `npm run dev`.
CORS_ORIGIN=http://localhost:5173

# --- Alamat service di belakang gateway ---
# Di docker-compose, isinya nama service: http://rbac:3001, dst.
RBAC_URL=http://localhost:3001
MASTER_URL=http://localhost:3002
TRANSAKSI_URL=http://localhost:3003
DOKUMEN_URL=http://localhost:3004

# Ke mana request non-/api diteruskan (aplikasi React).
# Docker: http://frontend:80 — dev: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Verifikasi token terbitan RBAC ---
RBAC_JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=bit-be-rbac
JWT_AUDIENCE=bit-beasiswa
JWKS_CACHE_DETIK=600

# --- Rate limit ---
RATE_LIMIT_PER_MENIT=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REFRESH=30
