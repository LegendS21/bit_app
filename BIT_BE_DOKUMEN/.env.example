# ------------------------------------------------------------------
# Contoh konfigurasi service Dokumen. Salin jadi .env lalu sesuaikan.
# File ini boleh di-commit — JANGAN taruh nilai rahasia asli di sini.
#
# Kredensial database dibaca `config/config.js` dari variabel DB_* di bawah.
# Kalau dikosongkan, dipakai nilai default untuk PostgreSQL lokal.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3004
TRUST_PROXY=1

# --- Database (PostgreSQL) ---
# Di docker-compose, DB_HOST diisi `postgres` (nama service), bukan 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=db_dokumen

CORS_ORIGIN=http://localhost:5173

# --- Verifikasi token dari service RBAC ---
RBAC_JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=bit-be-rbac
JWT_AUDIENCE=bit-beasiswa
JWKS_CACHE_DETIK=600

# --- Service lain ---
MASTER_BASE_URL=http://localhost:3002
TRANSAKSI_BASE_URL=http://localhost:3003

# --- Penyimpanan berkas ---
# Di produksi arahkan ke persistent volume, mis. /storage.
# Folder ini TIDAK boleh dilayani sebagai static directory.
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=10

# --- Pindai virus ---
# WAJIB true di produksi. Kalau false, berkas tidak dipindai dan disimpan
# berstatus PENDING (bukan CLEAN) supaya catatan auditnya tetap jujur.
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# --- Rate limit ---
RATE_LIMIT_PER_MENIT=100
