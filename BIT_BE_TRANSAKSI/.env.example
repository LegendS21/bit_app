# ------------------------------------------------------------------
# Contoh konfigurasi service Transaksi. Salin jadi .env lalu sesuaikan.
# File ini boleh di-commit — JANGAN taruh nilai rahasia asli di sini.
#
# Nilai yang mengandung tanda # wajib diapit tanda kutip, kalau tidak
# sisanya dianggap komentar oleh dotenv.
#
# Kredensial database TIDAK di sini — ada di `config/config.json`,
# mengikuti pola service RBAC dan Master.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3003
TRUST_PROXY=1

CORS_ORIGIN=http://localhost:5173

# --- Verifikasi token dari service RBAC ---
RBAC_JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=bit-be-rbac
JWT_AUDIENCE=bit-beasiswa
JWKS_CACHE_DETIK=600

# --- Service Master, untuk snapshot nama beasiswa & persyaratan ---
MASTER_BASE_URL=http://localhost:3002

# --- Rate limit ---
RATE_LIMIT_PER_MENIT=100
