# ------------------------------------------------------------------
# Seluruh request FE lewat API Gateway (bit_be_gateway), bukan lagi ke
# tiap service satu per satu.
#
# Biarkan KOSONG / jangan diisi kalau FE disajikan lewat gateway (susunan
# docker-compose). Nilai default "/api" bersifat relatif terhadap origin
# yang menyajikan halaman, sehingga hasil build tidak terikat ke satu host.
#
# Isi HANYA saat menjalankan `npm run dev` terpisah, dan arahkan ke gateway:
#   VITE_API_URL=http://localhost:3000/api
# ------------------------------------------------------------------

# VITE_API_URL=http://localhost:3000/api

# Catatan: VITE_API_MASTER_URL, VITE_API_TRANSAKSI_URL, dan
# VITE_API_DOKUMEN_URL sudah tidak dipakai — gateway yang memilah tujuannya.
