# Alamat tiap service. Untuk sementara menunjuk langsung karena
# bit_be_gateway belum dibuat — begitu gateway jadi, arahkan keduanya
# ke satu alamat gateway.
# RBAC: auth, users, roles, menus
VITE_API_URL=http://localhost:3001
# Master: beasiswa & data acuan
VITE_API_MASTER_URL=http://localhost:3002
# Transaksi: permohonan, verifikasi, wawancara, hasil
VITE_API_TRANSAKSI_URL=http://localhost:3003
# Dokumen: unggah & akses berkas persyaratan
VITE_API_DOKUMEN_URL=http://localhost:3004
