# ------------------------------------------------------------------
# Konfigurasi docker-compose untuk seluruh sistem BIT.
#
# Salin file ini jadi `.env` di folder yang sama, lalu ganti setiap nilai
# yang bertanda GANTI. File `.env` TIDAK ikut ter-commit ke git.
#
#   Windows PowerShell:  Copy-Item .env.example .env
# ------------------------------------------------------------------

# --- Database MySQL (dipakai RBAC, Master, Transaksi) ---
MYSQL_ROOT_PASSWORD=GANTI-password-mysql-yang-kuat

# --- Database PostgreSQL (dipakai Dokumen) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GANTI-password-postgres-yang-kuat

# --- Alamat frontend, dipakai untuk CORS di semua service ---
# Harus sama persis dengan alamat yang dibuka di browser, termasuk portnya.
CORS_ORIGIN=http://localhost:8080

# --- Port yang dipublikasikan ke laptop/server ---
# HANYA SATU. API Gateway adalah satu-satunya container yang terbuka;
# keempat service dan kedua database hanya bisa dihubungi dari dalam
# jaringan Docker, sesuai ketentuan "private subnet" di petunjuk.
PORT_GATEWAY=8080

# --- Pemindaian virus pada berkas unggahan ---
# WAJIB true di produksi. Kalau false, berkas tidak dipindai dan disimpan
# berstatus PENDING, bukan CLEAN.
CLAMAV_ENABLED=true

# --- Akun awal yang dibuat seeder RBAC ---
# Hanya terpakai saat `npm run db:seed` dijalankan manual.
SEED_ADMIN_EMAIL=admin@bit.test
SEED_ADMIN_PASSWORD=GANTI-password-admin
SEED_VERIFIKATOR_EMAIL=verifikator@bit.test
SEED_VERIFIKATOR_PASSWORD=GANTI-password-verifikator
SEED_SELEKSI_EMAIL=seleksi@bit.test
SEED_SELEKSI_PASSWORD=GANTI-password-seleksi
SEED_APPLICANT_EMAIL=peserta@bit.test
SEED_APPLICANT_PASSWORD=GANTI-password-peserta
