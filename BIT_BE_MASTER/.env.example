# ------------------------------------------------------------------
# Contoh konfigurasi service Master. Salin jadi .env lalu sesuaikan.
# File ini boleh di-commit — JANGAN taruh nilai rahasia asli di sini.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3002
TRUST_PROXY=1

# --- Database (MySQL) ---
# Dibaca `config/config.js`. Di docker-compose, DB_HOST diisi `mysql`
# (nama service), bukan 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=mysql
DB_DATABASE=db_master

CORS_ORIGIN=http://localhost:5173

# --- Verifikasi token dari service RBAC ---
RBAC_JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=bit-be-rbac
JWT_AUDIENCE=bit-beasiswa
JWKS_CACHE_DETIK=600

# --- Rate limit ---
RATE_LIMIT_PER_MENIT=100
